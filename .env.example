# ============================================
# RODEO - Zmienne Środowiskowe
# ============================================
#
# Ten plik zawiera przykładową konfigurację dla aplikacji RODEO.
# Skopiuj ten plik do .env i uzupełnij własnymi wartościami.
#
# UWAGA: Nie commituj pliku .env do repozytorium!
# ============================================

# --------------------------------------------
# Supabase Configuration
# --------------------------------------------
# URL twojego projektu Supabase
# Znajdziesz go w: Settings > API > Project URL
# Format: https://[your-project-id].supabase.co
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Klucz publiczny (anon key) dla Supabase
# Znajdziesz go w: Settings > API > Project API keys > anon public
# Ten klucz jest bezpieczny do użycia w przeglądarce
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --------------------------------------------
# Opcjonalne zmienne (dla Edge Functions)
# --------------------------------------------
# Te zmienne są konfigurowane w Supabase Dashboard
# w Project Settings > Edge Functions > Secrets

# Klucz API Resend.com do wysyłki emaili
# Rejestracja: https://resend.com/signup
# RESEND_API_KEY=re_xxxxxxxxxxxxx

# --------------------------------------------
# Development / Production
# --------------------------------------------
# Vite automatycznie ustawia NODE_ENV
# development - podczas npm run dev
# production - podczas npm run build

# --------------------------------------------
# Jak skonfigurować Supabase:
# --------------------------------------------
# 1. Stwórz konto na https://supabase.com
# 2. Utwórz nowy projekt
# 3. Poczekaj aż baza danych się uruchomi
# 4. Skopiuj URL i anon key z Settings > API
# 5. Uruchom migracje z folderu supabase/migrations/
# 6. (Opcjonalnie) Wdróż Edge Functions
#
# Dokumentacja: https://supabase.com/docs
# --------------------------------------------
